{
  "schema_version": "graph-gate-review-quality-eval-v1",
  "contract_id": "graph-gate-review-quality-hypothesis-test",
  "version": "0.2.0",
  "intent": "Test whether NEPA graph gates improve full EA review quality by adding deterministic gate evidence, consistency readback, and traceability without changing the underlying review, source-set, package, applicability, compliance, or phase-eval inputs.",
  "stop_condition": "Stop and record a blocked or null result if support for the hypothesis would require post-hoc threshold tuning, runtime compliance/phase-eval graph-gate adoption, new applicability or legal conclusions, hidden case-family heuristics, non-frozen full-review inputs, or production source_library mutation outside scoped gate-graph/eval commands.",
  "hypothesis": {
    "h1": "Graph-gated full EA review produces measurably higher artifact-derived review quality than the same full review read back without graph-gate evidence.",
    "h0": "Graph-gated full EA review does not produce a measurable artifact-derived review-quality improvement over the same full review read back without graph-gate evidence."
  },
  "threshold_policy": {
    "min_case_count": 3,
    "min_complete_case_count": 3,
    "min_distinct_review_count": 3,
    "min_positive_delta_case_count": 3,
    "max_critical_regression_count": 0,
    "max_case_contract_failure_count": 0,
    "min_net_quality_delta": 3.0
  },
  "quality_dimensions": [
    {
      "metric_id": "citation_gap_count",
      "label": "Citation or rule-claim support gap count",
      "direction": "lower_is_better",
      "critical": true
    },
    {
      "metric_id": "unsupported_gate_pass_count",
      "label": "Reviewer-ready pass without graph-gate proof",
      "direction": "lower_is_better",
      "critical": true
    },
    {
      "metric_id": "graph_gate_gap_count",
      "label": "Missing or failed graph-gate readback",
      "direction": "lower_is_better",
      "critical": true
    },
    {
      "metric_id": "readiness_blocker_count",
      "label": "Phase or readiness blocker count",
      "direction": "lower_is_better",
      "critical": true
    },
    {
      "metric_id": "graph_gate_consistency_score",
      "label": "Graph-gate consistency score",
      "direction": "higher_is_better",
      "critical": false
    },
    {
      "metric_id": "reviewer_traceability_score",
      "label": "Reviewer traceability score",
      "direction": "higher_is_better",
      "critical": false
    }
  ],
