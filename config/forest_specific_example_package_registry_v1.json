    },
    {
      "artifact_family_id": "applicability_validation",
      "path_mode": "review_file",
      "path_pattern": "source_library/reviews/<review_id>/applicability/applicability_validation.json",
      "read_purpose": "Fail-closed applicability validation for the package authority universe."
    },
    {
      "artifact_family_id": "compliance_review",
      "path_mode": "review_file",
      "path_pattern": "source_library/reviews/<review_id>/compliance_review.json",
      "read_purpose": "Canonical compliance review findings when the package has a completed compliance lane."
    },
    {
      "artifact_family_id": "compliance_review_eval",
      "path_mode": "review_file",
      "path_pattern": "source_library/reviews/<review_id>/compliance_review_eval/compliance_review_eval_results.json",
      "read_purpose": "Typed-blocked or replay-eval-only compliance status when canonical compliance review is intentionally unavailable."
    },
    {
      "artifact_family_id": "forest_plan_component_eval",
      "path_mode": "review_file",
      "path_pattern": "source_library/reviews/<review_id>/forest_plan_component_eval_results.json",
      "read_purpose": "Forest plan component evaluation summary for the package."
    },
    {
      "artifact_family_id": "review_packet_index",
      "path_mode": "review_file",
      "path_pattern": "source_library/reviews/<review_id>/review_packet_index/review_packet_index.json",
      "read_purpose": "Deterministic row ledger over the governed review packet when the package provides a full signer-facing index."
    },
    {
      "artifact_family_id": "review_packet_index_validation",
      "path_mode": "review_file",
      "path_pattern": "source_library/reviews/<review_id>/review_packet_index/review_packet_index_validation.json",
      "read_purpose": "Fail-closed validation sidecar for the review packet index."
    },
    {
      "artifact_family_id": "compliance_matrix_render_manifest",
      "path_mode": "review_file",
      "path_pattern": "source_library/reviews/<review_id>/review_packet_index/compliance_matrix_render_manifest.json",
      "read_purpose": "Rendered-row ledger for matrix-backed package artifacts when a full packet index is not yet present."
    },
    {
      "artifact_family_id": "decision_support",
      "path_mode": "review_file",
      "path_pattern": "source_library/reviews/<review_id>/decision_support/ea_consistency_decision_support.json",
      "read_purpose": "Responsible-official-facing synthesis over reviewed artifacts."
    },
    {
      "artifact_family_id": "draft_generation",
      "path_mode": "review_file",
      "path_pattern": "source_library/reviews/<review_id>/draft_generation/draft_generation_package.json",
      "read_purpose": "Governed reviewed-draft packet over existing audited artifacts."
    },
    {
      "artifact_family_id": "final_qa_certification",
      "path_mode": "review_dir",
      "path_pattern": "source_library/reviews/<review_id>/final_qa/",
      "read_purpose": "Final QA certification family when a package has a completed review closeout."
    }
  ],
